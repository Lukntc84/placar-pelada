# Copie para .env (ou configure no painel da Hostinger)

# Porta: na Hostinger normalmente é definida automaticamente
PORT=3000

# Conta de administrador (só você). Criada na primeira vez que o app liga.
# Depois de criada, mudar aqui NÃO troca a senha (troque pelo app).
# Esqueceu a senha? Defina ADMIN_RESET_PASSWORD=1, reinicie o app uma vez
# e depois apague o ADMIN_RESET_PASSWORD.
ADMIN_PHONE=11987654321
ADMIN_PASSWORD=troque-esta-senha
ADMIN_RESET_PASSWORD=

# ---- Banco MySQL da Hostinger (hPanel > Bancos de dados) ----
# Com DB_HOST preenchido o app usa o MySQL; vazio = arquivo data/db.json.
DB_HOST=localhost
DB_PORT=3306
DB_USER=u123456789_pelada
DB_PASSWORD=sua_senha
DB_NAME=u123456789_pelada

# Pasta para arquivos locais (db.json sem MySQL e backups automáticos).
# Use uma pasta FORA da pasta do app para não perder em um novo deploy.
DATA_DIR=./data
# Backups diários (padrão: DATA_DIR/backups), quantos dias guardar e fuso
BACKUP_DIR=
BACKUP_KEEP=7
TZ_BACKUP=America/Sao_Paulo

# Janela (segundos) em que o mesmo gol do mesmo jogador é tratado como duplicado
DUP_WINDOW_SECONDS=30
